<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>FluentBgWords</PackageId>
		<Version>0.1.0</Version>
		<Authors>Aleksandar Milev</Authors>
		<Description>Fluent API for writing monetary amounts in Bulgarian words (сума словом) - EUR/BGN, grammatical gender, invoice formats.</Description>
		<PackageTags>bulgarian;slovom;словом;number-to-words;amount-in-words;invoice;euro;leva</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Copyright>Copyright (c) 2026 Aleksandar Milev</Copyright>
		<PackageProjectUrl>https://github.com/aleksandarMilev/fluent-bg-words</PackageProjectUrl>
		<PackageReleaseNotes>See https://github.com/aleksandarMilev/fluent-bg-words/blob/master/CHANGELOG.md</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/aleksandarMilev/fluent-bg-words</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="FluentBgWords.Tests" />
	</ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>FluentBgWords</PackageId>
    <Description>Fluent API for writing monetary amounts in Bulgarian words (сума словом) - EUR/BGN, grammatical gender, invoice formats.</Description>
    <PackageTags>bulgarian;slovom;словом;number-to-words;amount-in-words;invoice;euro;leva</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation Condition="'$(Version.StartsWith(`0.0.0-`))' != 'true'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.2</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="FluentBgWords.Tests" />
  </ItemGroup>
</Project>
